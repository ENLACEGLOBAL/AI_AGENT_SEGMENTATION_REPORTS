# syntax=docker/dockerfile:1.7

# ---- Stage 1: build wheels (compilers stay here, never reach the final image) ----
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libfreetype6-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/install -r requirements.txt

# ---- Stage 2: runtime image (only interpreted libs + installed packages) ----
FROM python:3.11-slim

WORKDIR /app

# Runtime-only shared libs for ReportLab/Matplotlib (no -dev headers, no compiler)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfreetype6 \
    libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY . /app

ENV PYTHONUNBUFFERED=1 \
    UVICORN_WORKERS=2 \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

EXPOSE 8000
CMD ["uvicorn", "src.rta_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
